# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# IANA timezone name used by every cog that schedules at a fixed local time.
# Examples: UTC, Asia/Taipei, America/Los_Angeles, Europe/London
TIME_ZONE=UTC

# Comma-separated Discord user IDs allowed to run moderator-only commands
# (currently: /archive deleted, /archive show). Empty = those commands are
# disabled for everyone.
MODERATOR_IDS=

# --- Birthday cog ---
# Channel where the daily birthday announcement is posted.
BIRTHDAY_CHANNEL_ID=

# --- Archive cog ---
# Channel where the bot posts live edit/delete notices. This channel is
# automatically excluded from archiving (no recursion).
MOD_LOG_CHANNEL_ID=

# Comma-separated channel IDs the archive should ignore entirely (no logging,
# no edit/delete notices). Optional.
ARCHIVE_EXCLUDED_CHANNELS=

# --- Threads embedder cog ---
# Comma-separated channel IDs where the threads embedder should NOT run.
# Optional; default is to run everywhere.
THREADS_EXCLUDED_CHANNELS=
