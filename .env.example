# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# IANA timezone name used by every cog that schedules at a fixed local time.
# Examples: UTC, Asia/Taipei, America/Los_Angeles, Europe/London
TIME_ZONE=Asia/Taipei

# --- Feature toggles ---
# Each cog defaults to enabled; set to `false` (also: no/0/off) to skip
# loading it at startup. Disabled cogs register no commands, listeners,
# or task loops. Flipping the value requires a bot restart.
BIRTHDAY_ENABLED=true
ARCHIVE_ENABLED=true
LINK_EMBEDDER_ENABLED=true

# --- Birthday cog ---
# Channel where the daily birthday announcement is posted.
BIRTHDAY_CHANNEL_ID=

# --- Archive cog ---
# Channel where the bot posts live edit/delete notices. This channel is
# automatically excluded from archiving (no recursion).
MOD_LOG_CHANNEL_ID=

# Comma-separated channel IDs the archive should ignore entirely (no logging,
# no edit/delete notices). Optional.
ARCHIVE_EXCLUDED_CHANNELS=

# --- Link embedder cog (threads.com, instagram.com) ---
# Comma-separated channel IDs where the link embedder should NOT run.
# Optional; default is to run everywhere. The mod-log channel is always
# auto-excluded.
LINK_EMBEDDER_EXCLUDED_CHANNELS=

# URL of the Playwright-backed preview sidecar (see preview/). When set,
# the link embedder calls this for each rewritten link and attaches a
# custom Discord embed built from the OG metadata. Empty = disabled (the
# bot still rewrites URLs, just no custom embed). docker-compose.yml
# already wires this to http://preview:3000 inside the compose network.
PREVIEW_SERVICE_URL=
