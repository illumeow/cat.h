# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Channel ID where birthday announcements go (right-click channel -> Copy Channel ID; needs Developer Mode)
BIRTHDAY_CHANNEL_ID=

# IANA timezone name used for "today" and the 09:00 announcement.
# Examples: UTC, Asia/Taipei, America/Los_Angeles, Europe/London
TIME_ZONE=UTC
